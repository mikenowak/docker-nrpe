#!/bin/bash
# Define exit codes for Nagios/NRPE
OK=0
WARNING=1
CRITICAL=2
UNKNOWN=3

# Configuration
EXCLUDE_CONTAINERS="nrpe" # Add more containers to exclude, space-separated
MAX_AGE_CRITICAL=7 # Days - 7+ days old is critical

# Function to execute Docker commands in host namespace
docker_cmd() {
    nsenter -t 1 -m -u -n -i docker "$@"
}

# Function to check if string is in exclude list
is_excluded() {
    local container_name=$1
    for excluded in $EXCLUDE_CONTAINERS; do
        if [ "$container_name" == "$excluded" ]; then
            return 0
        fi
    done
    return 1
}

# Function to convert Docker timestamp to Unix timestamp
convert_timestamp() {
    local docker_time="$1"
    # Remove timezone abbreviation (EET, UTC, etc.) but keep offset
    cleaned_time=$(echo "$docker_time" | sed 's/ [A-Z]\{2,4\}$//')
    date -d "$cleaned_time" +%s 2>/dev/null || echo "0"
}

# Function to extract service name from swarm container name
get_service_name() {
    local container_name="$1"
    # Extract service name from swarm format: service_name.replica.id
    echo "$container_name" | sed 's/\.[0-9]\+\..*$//'
}

# Check if nsenter is available
if ! command -v nsenter >/dev/null 2>&1; then
    echo "UNKNOWN - nsenter command not found. Please install util-linux package."
    exit $UNKNOWN
fi

# Initialize arrays for storing results
declare -a warnings
declare -a criticals

# Get all running containers
containers=$(docker_cmd ps --format '{{.Names}}\t{{.CreatedAt}}\t{{.ID}}\t{{.Image}}' 2>/dev/null)

if [ $? -ne 0 ]; then
    echo "UNKNOWN - Cannot access Docker daemon through nsenter. Check if container has proper privileges."
    exit $UNKNOWN
fi

# Current timestamp
current_time=$(date +%s)

# Check each container
while IFS=$'\t' read -r name created_at id image; do
    # Skip if container is in exclude list or if line is empty
    [ -z "$name" ] && continue
    is_excluded "$name" && continue
    
    # Extract service name for swarm containers
    service_name=$(get_service_name "$name")
    
    # Convert creation time to timestamp and calculate age in days
    container_time=$(convert_timestamp "$created_at")
    age_days=$(( (current_time - container_time) / 86400 ))
    
    # Get the digest of the currently running image
    current_digest=$(docker_cmd inspect "$id" --format '{{.Image}}' 2>/dev/null)
    
    # Get the digest of the latest image available locally
    local_digest=$(docker_cmd image inspect "$image" --format '{{.Id}}' 2>/dev/null)
    
    # Check remote registry for latest digest using manifest inspect (no download)
    # This only fetches metadata, not the actual image
    remote_digest=$(docker_cmd manifest inspect "$image" 2>/dev/null | grep -o '"digest":"sha256:[a-f0-9]*"' | head -1 | cut -d'"' -f4)
    
    # Compare: if current container's image differs from local latest, or local differs from remote
    update_available=0
    
    if [ "$current_digest" != "$local_digest" ]; then
        update_available=1
    elif [ -n "$remote_digest" ] && [ "$remote_digest" != "unknown" ]; then
        # Compare local digest with remote (strip sha256: prefix if present)
        local_short=$(echo "$local_digest" | sed 's/sha256://')
        remote_short=$(echo "$remote_digest" | sed 's/sha256://')
        if [ "$local_short" != "$remote_short" ]; then
            update_available=1
        fi
    fi
    
    if [ $update_available -eq 1 ]; then
        if [ $age_days -ge $MAX_AGE_CRITICAL ]; then
            criticals+=("$service_name [Age: ${age_days}d]")
        else
            warnings+=("$service_name [Age: ${age_days}d]")
        fi
    fi
done <<< "$containers"

# Prepare output
output=""
exit_code=$OK

if [ ${#criticals[@]} -gt 0 ]; then
    output="CRITICAL - Updates available: ${criticals[*]}"
    exit_code=$CRITICAL
elif [ ${#warnings[@]} -gt 0 ]; then
    output="WARNING - Updates available: ${warnings[*]}"
    exit_code=$WARNING
else
    output="OK - All monitored containers are up to date"
fi

# Add performance data
total_containers=$(docker_cmd ps -q | wc -l)
critical_count=${#criticals[@]}
warning_count=${#warnings[@]}

output="$output | total=$total_containers critical=$critical_count warning=$warning_count"

echo "$output"
exit $exit_code
